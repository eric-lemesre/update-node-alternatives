#!/bin/sh
# postrm script for update-node-alternatives
#
# On purge:
#   - drops the update-alternatives entries that update-node-alternatives
#     may have registered for node/npm/npx/corepack at runtime;
#   - re-confirms via debconf whether to wipe /usr/local/share/nvm/
#     (the Node.js versions store) and acts on the answer.
#
# The store lives outside /usr (under /usr/local) and the admin's
# preference was recorded at install time
# (update-node-alternatives/purge-nvm-store), so this only re-asks for
# explicit confirmation -- with the previously chosen value preselected.

set -e

case "$1" in
    purge)
        # Read the union of binaries registered as alternatives by
        # do_update() (master + dynamic slaves like ng, tsc, ...). If
        # the state file is missing, fall back to the binaries every
        # Node.js install ships.
        info="/usr/local/share/nvm/versions/node_binaries.info"
        bins=""
        if [ -r "$info" ]; then
            bins=$(awk -F= '$1 == "Binaries" { print $2; exit }' "$info" 2>/dev/null)
        fi
        [ -n "$bins" ] || bins="node npm npx corepack"
        case " $bins " in
            *" node "*) ;;
            *) bins="node $bins" ;;
        esac

        for alt in $bins; do
            update-alternatives --remove-all "$alt" 2>/dev/null || true
        done

        if [ -e /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule

            # Re-ask the question with the previously stored value as
            # the default. The user can change their mind here.
            db_input high update-node-alternatives/purge-nvm-store || true
            db_go || true

            db_get update-node-alternatives/purge-nvm-store || RET=false
            if [ "$RET" = "true" ] && [ -d /usr/local/share/nvm ]; then
                echo "Removing /usr/local/share/nvm/ (every installed Node.js version)..."
                rm -rf /usr/local/share/nvm
            fi
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
