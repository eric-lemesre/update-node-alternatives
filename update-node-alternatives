# it under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version.
#

# Les fonctions do_* et dialog_* sont appelees dynamiquement (do_$action, etc.)
# shellcheck disable=SC2329

shopt -s dotglob

prog=$(basename "$0")

readonly NVM_DIR="/usr/local/share/nvm"
readonly top="${NVM_DIR}/versions/node"
readonly ALTBIN_DIR="/usr/local/bin"
readonly node_info="$NVM_DIR/versions/node_binaries.info"

declare -A NEW_BIN
declare -A OLD_BIN

verbose=

usage()
{
    rv=$1
    cat >&2 <<-EOF
	usage: $prog [-v|--verbose] <action> [options]

	Actions (NVM):
	  -i, --install <version>            Installer une version Node.js
	  -r, --remove <version>             Supprimer une version installee
	  -R, --list-remote [--lts]          Lister les versions disponibles au telechargement
	  -p, --list-packages <version>      Lister les paquets globaux d'une version
	  --upgrade <version> [--from <ver>] Installer, activer et migrer les paquets
	  --reinstall-packages --from <ver> --to <ver>
	                                     Migrer les paquets globaux entre deux versions

	Actions (alternatives):
	  -l, --list                         Lister les versions installees localement
	  -s, --set <nodename>               Definir la version active (mode manuel)
	  -u, --update                       Re-enregistrer toutes les versions dans alternatives
	                                     (rejouez apres 'npm install -g <pkg>' pour
	                                     ajouter <pkg> aux alternatives)
	  -a, --auto                         Basculer en mode automatique (plus haute priorite)

	Actions (paquets npm -g per-user):
	  --promote-user-globals             [root] Promouvoir les paquets npm -g
	                                     de \$SUDO_USER vers la couche system-wide
	  --cleanup-user-globals             [user] Supprimer les paquets per-user
	                                     deja couverts par la couche system-wide

	Options:
	  -v, --verbose                      Affichage detaille
	  --frontend <name>                  Forcer un frontend interactif:
	                                       dialog, readline, gnome, kde,
	                                       noninteractive
	  --no-dialog                        Alias de --frontend=readline
	  -h, -?, --help                     Afficher cette aide

	Honore aussi DEBIAN_FRONTEND (cf. debconf(7)). Le frontend est sinon
	auto-detecte: GUI (zenity/kdialog) si \$DISPLAY/\$WAYLAND_DISPLAY,
	sinon TTY (whiptail/dialog), sinon readline.

	<version> : numero de version (22, 20, v22.14.0, lts/jod, lts/*, etc.)
	<nodename> : repertoire exact de version (v22.14.0, v20.18.1)

	Exemples:
	  sudo $prog --install 22                      # Installer la derniere Node 22
	  sudo $prog --install lts/jod                 # Installer une LTS par nom
	  $prog --list-remote --lts                    # Voir les LTS disponibles
	  $prog --list-packages v22.14.0               # Paquets globaux de Node 22
	  sudo $prog --set v22.14.0                    # Basculer sur Node 22.14.0
	  sudo $prog --upgrade 22 --from v20.18.1     # Upgrade 20->22 + migration paquets
	  sudo $prog --remove v20.18.1                 # Supprimer Node 20
	  sudo $prog --reinstall-packages --from v20.18.1 --to v22.14.0
	  sudo $prog --auto                            # Mode auto (plus haute priorite)
	EOF
    exit "$rv"
}

action=
nodename=
from_version=
to_version=
lts_only=
forced_frontend=
uaopts=(--quiet)

while [ "$#" -gt 0 ]; do
    case "$1" in
      -i|--install)
	[ -z "$action" ] || usage 1
	action=install
	shift
	[ "$#" -gt 0 ] || usage 1
	nodename=$1;;
      -r|--remove)
	[ -z "$action" ] || usage 1
	action=remove
	shift
	[ "$#" -gt 0 ] || usage 1
	nodename=$1;;
      -R|--list-remote)
	[ -z "$action" ] || usage 1
	action=list_remote;;
      -p|--list-packages)
	[ -z "$action" ] || usage 1
	action=list_packages
	shift
	[ "$#" -gt 0 ] || usage 1
	nodename=$1;;
      --upgrade)
	[ -z "$action" ] || usage 1
	action=upgrade
	shift
	[ "$#" -gt 0 ] || usage 1
	nodename=$1;;
      --reinstall-packages)
	[ -z "$action" ] || usage 1
	action=reinstall_packages;;
      --from)
	shift
	[ "$#" -gt 0 ] || usage 1
	from_version=$1;;
      --to)
	shift
	[ "$#" -gt 0 ] || usage 1
	to_version=$1;;
      --lts)
	lts_only=yes;;
      --no-dialog)
	forced_frontend=readline;;
      --frontend)
	shift
	[ "$#" -gt 0 ] || usage 1
	forced_frontend=$1;;
      --frontend=*)
	forced_frontend=${1#--frontend=};;
      -a|--auto)
	[ -z "$action" ] || usage 1
	action=auto;;
      -l|--list)
	[ -z "$action" ] || usage 1
	action=list;;
      -u|--update)
	[ -z "$action" ] || usage 1
	action=update;;
      --promote-user-globals)
	[ -z "$action" ] || usage 1
	action=promote_user_globals;;
      --cleanup-user-globals)
	[ -z "$action" ] || usage 1
	action=cleanup_user_globals;;
      -s|--set)
	[ -z "$action" ] || usage 1
	action="set"
	shift
	[ "$#" -gt 0 ] || usage 1
	nodename=$1;;
      -v|--verbose)
	verbose=yes
	uaopts=();;
      -h|-\?|--help)
	usage 0;;
      -*)
	echo >&2 "$prog: option inconnue: $1"
	usage 1;;
      *)
	break;;
    esac
    shift
done

[ "$#" -eq 0 ] || usage 1
[ -n "$action" ] || usage 1

# ---------------------------------------------------------------------------
# Frontends interactifs (honore DEBIAN_FRONTEND)
# ---------------------------------------------------------------------------
#
# Frontends supportes:
#   dialog          whiptail (preferred) ou dialog -- TTY
#   readline        prompt readline classique -- TTY sans courbes
#   gnome           zenity -- GUI GTK (apt install zenity)
#   kde             kdialog -- GUI Qt (apt install kdialog)
#   noninteractive  pas de question, reponses par defaut sures
#
# Selection, par ordre de priorite:
#   1. --frontend=NAME (option CLI)
#   2. --no-dialog (alias historique de --frontend=readline)
#   3. variable d'environnement DEBIAN_FRONTEND
#   4. detection auto: GUI si DISPLAY/WAYLAND_DISPLAY + zenity/kdialog dispo,
#      sinon dialog si whiptail/dialog dispo, sinon readline.

frontend=

if [ -n "$forced_frontend" ]; then
    frontend="$forced_frontend"
elif [ -n "${DEBIAN_FRONTEND:-}" ]; then
    case "$DEBIAN_FRONTEND" in
        dialog|whiptail)         frontend=dialog ;;
        readline|text|editor)    frontend=readline ;;
        gnome)                   frontend=gnome ;;
        kde)                     frontend=kde ;;
        noninteractive)          frontend=noninteractive ;;
        *)                       frontend= ;;
    esac
fi

if [ -z "$frontend" ]; then
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        if command -v zenity >/dev/null 2>&1; then
            frontend=gnome
        elif command -v kdialog >/dev/null 2>&1; then
            frontend=kde
        fi
    fi
fi
if [ -z "$frontend" ]; then
    if command -v whiptail >/dev/null 2>&1 || command -v dialog >/dev/null 2>&1; then
        frontend=dialog
    else
        frontend=readline
    fi
fi

DIALOG_BIN=""
case "$frontend" in
    dialog)
        if command -v whiptail >/dev/null 2>&1; then
            DIALOG_BIN=whiptail
        elif command -v dialog >/dev/null 2>&1; then
            DIALOG_BIN=dialog
        else
            echo >&2 "$prog: frontend=dialog mais ni whiptail ni dialog n'est installe"
            exit 1
        fi ;;
    gnome)
        command -v zenity >/dev/null 2>&1 || {
            echo >&2 "$prog: frontend=gnome requiert zenity (apt install zenity)"; exit 1; }
        DIALOG_BIN=zenity ;;
    kde)
        command -v kdialog >/dev/null 2>&1 || {
            echo >&2 "$prog: frontend=kde requiert kdialog (apt install kdialog)"; exit 1; }
        DIALOG_BIN=kdialog ;;
    readline|noninteractive)
        DIALOG_BIN= ;;
    *)
        echo >&2 "$prog: frontend inconnu: $frontend"
        echo >&2 "  valides: dialog, readline, gnome, kde, noninteractive"
        exit 1 ;;
esac

# Taille du terminal pour les dialogues
# Remplit les variables globales DIALOG_ROWS et DIALOG_COLS
dialog_size()
{
    DIALOG_ROWS=$(tput lines 2>/dev/null || echo 24)
    DIALOG_COLS=$(tput cols 2>/dev/null || echo 80)
    [ "$DIALOG_ROWS" -gt 40 ] && DIALOG_ROWS=40
    [ "$DIALOG_COLS" -gt 100 ] && DIALOG_COLS=100
}

# Question oui/non
# Usage: dialog_yesno "titre" "texte"
# Retour: 0=oui, 1=non (en mode noninteractive: 1)
dialog_yesno()
{
    local title="$1" text="$2"
    case "$frontend" in
        dialog)
            dialog_size
            "$DIALOG_BIN" --title "$title" --yesno "$text" "$DIALOG_ROWS" "$DIALOG_COLS"
            return $? ;;
        gnome)
            zenity --question --title="$title" --text="$text" 2>/dev/null
            return $? ;;
        kde)
            kdialog --title "$title" --yesno "$text"
            return $? ;;
        noninteractive)
            vecho "$prog: noninteractive: $title -> non (defaut)"
            return 1 ;;
        readline|*)
            local answer
            read -rp "$text [o/N]: " answer
            [[ "$answer" =~ ^[oOyY] ]]
            return $? ;;
    esac
}

# Checklist interactive (selection multiple)
# Usage: dialog_checklist "titre" "texte" tag1 desc1 ON/OFF tag2 desc2 ON/OFF ...
# Retour: tags selectionnes (separes par espaces) sur stdout, rc=0 si OK
dialog_checklist()
{
    local title="$1" text="$2"
    shift 2

    case "$frontend" in
        dialog)
            dialog_size
            local list_height=$(( DIALOG_ROWS - 8 ))
            [ "$list_height" -gt 20 ] && list_height=20

            local result
            if [ "$DIALOG_BIN" = "whiptail" ]; then
                result=$("$DIALOG_BIN" --title "$title" --checklist "$text" \
                    "$DIALOG_ROWS" "$DIALOG_COLS" "$list_height" "$@" 3>&1 1>&2 2>&3)
            else
                result=$("$DIALOG_BIN" --title "$title" --checklist "$text" \
                    "$DIALOG_ROWS" "$DIALOG_COLS" "$list_height" "$@" 2>&1 1>/dev/tty)
            fi
            local rc=$?
            echo "$result" | tr -d '"'
            return "$rc" ;;
        gnome)
            # zenity --list --checklist : "TRUE/FALSE tag desc" puis separator
            local zargs=()
            while [ "$#" -ge 3 ]; do
                local tag="$1" desc="$2" state="$3"
                shift 3
                local checked=FALSE
                [ "$state" = "ON" ] && checked=TRUE
                zargs+=("$checked" "$tag" "$desc")
            done
            local result rc
            result=$(zenity --list --checklist --title="$title" --text="$text" \
                --column="" --column="Paquet" --column="Description" \
                --separator=' ' --width=600 --height=400 \
                "${zargs[@]}" 2>/dev/null)
            rc=$?
            [ "$rc" -eq 0 ] && echo "$result"
            return "$rc" ;;
        kde)
            # kdialog --checklist title text tag desc on/off ...
            local kargs=()
            while [ "$#" -ge 3 ]; do
                local tag="$1" desc="$2" state="$3"
                shift 3
                local checked=off
                [ "$state" = "ON" ] && checked=on
                kargs+=("$tag" "$desc" "$checked")
            done
            local result rc
            result=$(kdialog --separate-output --title "$title" \
                --checklist "$text" "${kargs[@]}")
            rc=$?
            [ "$rc" -eq 0 ] && echo "$result" | tr '\n' ' '
            return "$rc" ;;
        noninteractive)
            vecho "$prog: noninteractive: $title -> selection vide (defaut)"
            return 1 ;;
        readline|*)
            echo >&2 "$title"
            echo >&2 "$text"
            echo >&2
            local i=0
            local items=()
            while [ "$#" -ge 3 ]; do
                local tag="$1" desc="$2" state="$3"
                shift 3
                i=$((i + 1))
                local mark=" "
                [ "$state" = "ON" ] && mark="*"
                printf >&2 "  [%s] %d) %-30s %s\n" "$mark" "$i" "$tag" "$desc"
                items+=("$tag")
            done
            echo >&2
            echo >&2 "Entrez les numeros a selectionner (espace pour separer), 'a' pour tout, 'n' pour rien:"
            local selections
            read -rp "> " selections
            case "$selections" in
                [aA]|[aA]ll)
                    echo "${items[*]}"
                    return 0 ;;
                [nN]|"")
                    return 1 ;;
                *)
                    local selected=()
                    for sel in $selections; do
                        if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#items[@]}" ]; then
                            selected+=("${items[$((sel - 1))]}")
                        fi
                    done
                    if [ ${#selected[@]} -gt 0 ]; then
                        echo "${selected[*]}"
                        return 0
                    fi
                    return 1 ;;
            esac ;;
    esac
}

# Menu (selection unique)
# Usage: dialog_menu "titre" "texte" tag1 desc1 tag2 desc2 ...
# Retour: tag selectionne sur stdout
dialog_menu()
{
    local title="$1" text="$2"
    shift 2

    case "$frontend" in
        dialog)
            dialog_size
            local list_height=$(( DIALOG_ROWS - 8 ))
            [ "$list_height" -gt 15 ] && list_height=15

            local result
            if [ "$DIALOG_BIN" = "whiptail" ]; then
                result=$("$DIALOG_BIN" --title "$title" --menu "$text" \
                    "$DIALOG_ROWS" "$DIALOG_COLS" "$list_height" "$@" 3>&1 1>&2 2>&3)
            else
                result=$("$DIALOG_BIN" --title "$title" --menu "$text" \
                    "$DIALOG_ROWS" "$DIALOG_COLS" "$list_height" "$@" 2>&1 1>/dev/tty)
            fi
            local rc=$?
            echo "$result"
            return "$rc" ;;
        gnome)
            local zargs=()
            while [ "$#" -ge 2 ]; do
                zargs+=("$1" "$2")
                shift 2
            done
            local result rc
            result=$(zenity --list --title="$title" --text="$text" \
                --column="Tag" --column="Description" \
                --width=600 --height=400 \
                "${zargs[@]}" 2>/dev/null)
            rc=$?
            [ "$rc" -eq 0 ] && echo "$result"
            return "$rc" ;;
        kde)
            local result rc
            result=$(kdialog --title "$title" --menu "$text" "$@")
            rc=$?
            [ "$rc" -eq 0 ] && echo "$result"
            return "$rc" ;;
        noninteractive)
            vecho "$prog: noninteractive: $title -> aucun choix"
            return 1 ;;
        readline|*)
            echo >&2 "$title"
            echo >&2 "$text"
            echo >&2
            local i=0
            local tags=()
            while [ "$#" -ge 2 ]; do
                local tag="$1" desc="$2"
                shift 2
                i=$((i + 1))
                printf >&2 "  %d) %-20s %s\n" "$i" "$tag" "$desc"
                tags+=("$tag")
            done
            echo >&2
            local sel
            read -rp "Choix (1-$i): " sel
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#tags[@]}" ]; then
                echo "${tags[$((sel - 1))]}"
                return 0
            fi
            return 1 ;;
    esac
}

# Message d'information
dialog_msgbox()
{
    local title="$1" text="$2"
    case "$frontend" in
        dialog)
            dialog_size
            "$DIALOG_BIN" --title "$title" --msgbox "$text" "$DIALOG_ROWS" "$DIALOG_COLS" ;;
        gnome)
            zenity --info --title="$title" --text="$text" 2>/dev/null ;;
        kde)
            kdialog --title "$title" --msgbox "$text" ;;
        noninteractive|readline|*)
            echo "$title"
            echo "$text" ;;
    esac
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

vecho()
{
    [ -z "$verbose" ] || echo >&2 "$@"
}

# Charger NVM dans le contexte du script
# NVM_DIR = ou sont stockes les versions + le cache (/usr/local/share/nvm)
# nvm.sh est cherche en priorite dans le paquet, puis en vendor (exec depuis source),
# puis dans NVM_DIR pour compatibilite avec l'ancien install-node-alternative.sh.
load_nvm()
{
    export NVM_DIR
    mkdir -p "$NVM_DIR/versions/node" "$NVM_DIR/alias" "$NVM_DIR/.cache" 2>/dev/null || true

    local script_dir nvm_lib=""
    script_dir=$(dirname "$(readlink -f "$0")")
    local candidates=(
        "/usr/share/update-node-alternatives/nvm/nvm.sh"
        "$script_dir/vendor/nvm/nvm.sh"
        "$NVM_DIR/nvm.sh"
    )
    local c
    for c in "${candidates[@]}"; do
        if [ -s "$c" ]; then
            nvm_lib="$c"
            break
        fi
    done

    if [ -z "$nvm_lib" ]; then
        echo >&2 "$prog: nvm.sh introuvable"
        echo >&2 "  Cherche dans:"
        for c in "${candidates[@]}"; do
            echo >&2 "    $c"
        done
        echo >&2 "  Reinstallez le paquet (apt install update-node-alternatives)"
        echo >&2 "  ou copiez un nvm.sh dans l'un de ces chemins."
        exit 1
    fi

    # shellcheck source=/dev/null
    . "$nvm_lib" --no-use
}

# Calcul de priorite a partir du numero de version
# v22.14.0 -> 2214, v20.18.1 -> 2018, v24.5.0 -> 2405
calc_priority()
{
    local ver="${1#v}"
    local major minor
    IFS='.' read -r major minor _ <<< "$ver"
    echo $(( major * 100 + minor ))
}

# Resout un alias NVM (22, lts/jod, etc.) vers la version exacte installee localement
resolve_local()
{
    local input="$1"
    # Si c'est deja un vX.Y.Z exact et present
    if [[ "$input" == v* ]] && [ -d "$top/$input" ]; then
        echo "$input"
        return
    fi
    # Sinon, demander a NVM
    load_nvm
    local resolved
    resolved=$(nvm version "$input" 2>/dev/null)
    if [[ -z "$resolved" || "$resolved" == "N/A" ]]; then
        echo >&2 "$prog: version '$input' non installee localement"
        echo >&2 "  Versions disponibles:"
        list_installed_versions | sed 's/^/    /' >&2
        exit 1
    fi
    echo "$resolved"
}

# Lister les versions installees (un par ligne), sans utiliser ls (SC2012)
list_installed_versions()
{
    local d
    for d in "$top"/v*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done
}

# Lister les binaires d'une version (slaves potentiels), sans 'node' (master).
# Chaque appel a do_update() reevalue cette liste pour capter les binaires
# poses par 'npm install -g <pkg>' (ng, tsc, pnpm, yarn, ...).
# Usage: scan_slaves <NODEBIN_DIR>
scan_slaves()
{
    local bin_dir="$1"
    local f name
    [ -d "$bin_dir" ] || return 0
    for f in "$bin_dir"/*; do
        [ -e "$f" ] || continue
        [ -d "$f" ] && continue
        [ -x "$f" ] || continue
        name=$(basename "$f")
        case "$name" in
            node|.*) continue ;;
        esac
        printf '%s\n' "$name"
    done | sort -u
}

# Lit les paquets globaux d'un repertoire lib/node_modules quelconque.
# Usage: collect_modules_dir <modules_dir>
# Remplit les tableaux: pkg_names[], pkg_versions[], pkg_descriptions[]
collect_modules_dir()
{
    local modules_dir="$1"

    pkg_names=()
    pkg_versions=()
    pkg_descriptions=()

    [ -d "$modules_dir" ] || return

    # Paquets non-scoped
    local pkg_dir name ver desc
    for pkg_dir in "$modules_dir"/*/; do
        [ -d "$pkg_dir" ] || continue
        name=$(basename "$pkg_dir")
        case "$name" in
            npm|corepack|@*) continue ;;  # scoped traites en deuxieme passe
        esac
        ver="" desc=""
        if [ -f "$pkg_dir/package.json" ]; then
            ver=$(grep -m1 '"version"' "$pkg_dir/package.json" | grep -oP '[\d.]+' | head -1)
            desc=$(grep -m1 '"description"' "$pkg_dir/package.json" | sed 's/.*"description"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | head -c 50)
        fi
        pkg_names+=("$name")
        pkg_versions+=("$ver")
        pkg_descriptions+=("$desc")
    done

    # Paquets scoped (@org/pkg)
    local scope_dir scope base
    for scope_dir in "$modules_dir"/@*/; do
        [ -d "$scope_dir" ] || continue
        for pkg_dir in "$scope_dir"*/; do
            [ -d "$pkg_dir" ] || continue
            scope=$(basename "$(dirname "$pkg_dir")")
            base=$(basename "$pkg_dir")
            name="$scope/$base"
            ver="" desc=""
            if [ -f "$pkg_dir/package.json" ]; then
                ver=$(grep -m1 '"version"' "$pkg_dir/package.json" | grep -oP '[\d.]+' | head -1)
                desc=$(grep -m1 '"description"' "$pkg_dir/package.json" | sed 's/.*"description"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | head -c 50)
            fi
            pkg_names+=("$name")
            pkg_versions+=("$ver")
            pkg_descriptions+=("$desc")
        done
    done
}

# Lister les paquets globaux d'une version installee dans la couche 2.
# Usage: collect_global_packages <version>
collect_global_packages()
{
    collect_modules_dir "$top/$1/lib/node_modules"
}

# Repertoire personnel d'un utilisateur Unix (passwd[6])
get_user_home()
{
    getent passwd "$1" | cut -d: -f6
}

# Prefix npm per-user d'un utilisateur. Recherche, dans l'ordre :
#   1. `sudo -u <user> -H npm config get prefix` (config standard npm)
#   2. ~/.npm-global (defaut shippe par /etc/profile.d/update-node-alternatives.sh)
# Refuse les prefixes system-wide pour eviter les boucles. RC 0 si trouve.
get_user_npm_prefix()
{
    local user="$1" home_dir prefix
    home_dir=$(get_user_home "$user")
    [ -n "$home_dir" ] || return 1

    if command -v npm >/dev/null 2>&1; then
        if [ "$(id -un)" = "$user" ]; then
            prefix=$(npm config get prefix 2>/dev/null) || prefix=
        else
            prefix=$(sudo -u "$user" -H npm config get prefix 2>/dev/null) || prefix=
        fi
        case "$prefix" in
            ""|/usr|/usr/local|/usr/local/share/nvm/*) prefix= ;;
        esac
        if [ -n "$prefix" ] && [ -d "$prefix/lib/node_modules" ]; then
            echo "$prefix"
            return 0
        fi
    fi

    if [ -d "$home_dir/.npm-global/lib/node_modules" ]; then
        echo "$home_dir/.npm-global"
        return 0
    fi

    return 1
}

# Compare deux versions style x.y.z (via dpkg). RC 0 si $1 >= $2.
version_ge()
{
    [ "$1" = "$2" ] && return 0
    dpkg --compare-versions "$1" ge "$2" 2>/dev/null
}

# Repertoire lib/node_modules de la version active (alternative `node`).
# Affiche le chemin sur stdout, RC 0 si une version est active.
active_node_modules_dir()
{
    local current
    current=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
    [ -n "$current" ] || return 1
    local active_version
    active_version=$(echo "$current" | grep -oP 'v[\d.]+')
    [ -n "$active_version" ] || return 1
    echo "$top/$active_version/lib/node_modules"
}

do_show_setting()
{
    printf "%-20s %s\n" "NVM_DIR" "$NVM_DIR"
    printf "%-20s %s\n" "top" "$top"
    printf "%-20s %s\n" "node_info" "$node_info"
    printf "%-20s %s\n" "nodename" "${nodename:-<non defini>}"
    printf "%-20s %s\n" "from_version" "${from_version:-<non defini>}"
    printf "%-20s %s\n" "to_version" "${to_version:-<non defini>}"
    printf "%-20s %s\n" "frontend" "$frontend"
    printf "%-20s %s\n" "DIALOG_BIN" "${DIALOG_BIN:-<aucun>}"
    printf "%-20s %s\n" "DEBIAN_FRONTEND" "${DEBIAN_FRONTEND:-<non defini>}"
}

# ---------------------------------------------------------------------------
# Actions NVM
# ---------------------------------------------------------------------------

do_install()
{
    [ -n "$nodename" ] || { echo >&2 "$prog: version requise"; usage 1; }

    load_nvm

    echo ":: Telechargement et installation de Node.js '$nodename' via NVM..."
    if ! nvm install "$nodename"; then
        echo >&2 "$prog: echec de l'installation de '$nodename'"
        exit 1
    fi

    # Recuperer la version exacte installee
    local installed
    installed=$(nvm version "$nodename" 2>/dev/null)
    if [[ -z "$installed" || "$installed" == "N/A" ]]; then
        echo >&2 "$prog: impossible de determiner la version installee"
        exit 1
    fi

    echo ":: Enregistrement de $installed dans update-alternatives..."
    do_update

    echo
    echo ":: Installation terminee: $installed"
    echo "   Pour activer: sudo $prog --set $installed"
    echo "   Pour auto:    sudo $prog --auto"
}

do_remove()
{
    [ -n "$nodename" ] || { echo >&2 "$prog: version requise"; usage 1; }

    local version
    version=$(resolve_local "$nodename")

    # Verifier que ce n'est pas la version active
    local current_bin
    current_bin=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
    if [[ "$current_bin" == *"$version"* ]]; then
        if ! dialog_yesno "Suppression de la version active" \
            "$version est actuellement la version active du systeme.\n\nContinuer la suppression ?"; then
            echo "Annule."
            exit 0
        fi
    fi

    echo ":: Desenregistrement de $version des alternatives..."
    local node_bin="$top/$version/bin/node"
    update-alternatives --remove node "$node_bin" 2>/dev/null || true

    echo ":: Suppression de $version via NVM..."
    load_nvm
    nvm uninstall "$version"

    echo ":: $version supprime"

    # Re-enregistrer si il reste des versions
    if [ -n "$(ls -A "$top" 2>/dev/null)" ]; then
        echo ":: Mise a jour des alternatives restantes..."
        do_update
    else
        echo "  Plus aucune version installee."
        update-alternatives --remove-all node 2>/dev/null || true
    fi
}

do_list_remote()
{
    load_nvm

    if [ -n "$lts_only" ]; then
        echo "Versions LTS disponibles au telechargement:"
        echo
        nvm ls-remote --lts
    else
        echo "Versions disponibles au telechargement (30 dernieres):"
        echo
        nvm ls-remote | tail -30
        echo
        echo "  (utilisez --lts pour filtrer les LTS uniquement)"
    fi
}

do_list_packages()
{
    [ -n "$nodename" ] || { echo >&2 "$prog: version requise"; usage 1; }

    local version
    version=$(resolve_local "$nodename")
    local modules_dir="$top/$version/lib/node_modules"

    collect_global_packages "$version"

    if [ ${#pkg_names[@]} -eq 0 ]; then
        echo "Aucun paquet global installe pour $version"
        echo "  (module_dir: $modules_dir)"
        return
    fi

    echo "Paquets globaux installes pour $version:"
    echo
    printf "  %-30s %-12s %s\n" "PAQUET" "VERSION" "DESCRIPTION"
    printf "  %-30s %-12s %s\n" "------" "-------" "-----------"

    local i
    for i in "${!pkg_names[@]}"; do
        printf "  %-30s %-12s %s\n" \
            "${pkg_names[$i]}" \
            "${pkg_versions[$i]}" \
            "${pkg_descriptions[$i]}"
    done

    echo
    echo "Total: ${#pkg_names[@]} paquet(s)"
}

do_upgrade()
{
    [ -n "$nodename" ] || { echo >&2 "$prog: version cible requise"; usage 1; }

    # Detecter la version source
    if [ -z "$from_version" ]; then
        local current_bin
        current_bin=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
        if [ -n "$current_bin" ]; then
            from_version=$(echo "$current_bin" | grep -oP 'v[\d.]+')
        fi
    fi

    if [ -z "$from_version" ]; then
        echo >&2 "$prog: impossible de determiner la version source"
        echo >&2 "  Specifiez --from <version> ou activez une version d'abord"
        exit 1
    fi

    echo ":: Upgrade: $from_version -> $nodename"
    echo

    # 1. Installer la nouvelle version
    load_nvm
    echo "[1/3] Installation de Node.js '$nodename'..."
    if ! nvm install "$nodename"; then
        echo >&2 "$prog: echec de l'installation"
        exit 1
    fi

    local installed
    installed=$(nvm version "$nodename" 2>/dev/null)

    # 2. Enregistrer et activer
    echo "[2/3] Activation de $installed..."
    do_update
    local NODEBIN_DIR="$top/${installed}/bin"
    update-alternatives "${uaopts[@]}" --set node "$NODEBIN_DIR/node"

    echo "  node: $("$ALTBIN_DIR/node" --version 2>/dev/null)"
    echo "  npm:  $("$ALTBIN_DIR/npm" --version 2>/dev/null)"
    echo

    # 3. Migration des paquets globaux
    echo "[3/3] Migration des paquets globaux..."
    migrate_global_packages "$from_version" "$installed"

    echo
    echo ":: Upgrade termine: $from_version -> $installed"
}

do_reinstall_packages()
{
    if [ -z "$from_version" ] || [ -z "$to_version" ]; then
        echo >&2 "$prog: --from et --to requis"
        echo >&2 "  usage: $prog --reinstall-packages --from v20.18.1 --to v22.14.0"
        exit 1
    fi

    local src
    src=$(resolve_local "$from_version")
    local dst
    dst=$(resolve_local "$to_version")

    echo ":: Migration des paquets globaux: $src -> $dst"
    migrate_global_packages "$src" "$dst"
}

# ---------------------------------------------------------------------------
# Actions alternatives
# ---------------------------------------------------------------------------

do_list()
{
    vecho "Versions Node.js installees dans $top:"
    echo
    printf "  %-16s %-10s %s\n" "VERSION" "PRIORITE" "CHEMIN"
    printf "  %-16s %-10s %s\n" "-------" "--------" "------"

    if [ ! -d "$top" ] || [ -z "$(ls -A "$top" 2>/dev/null)" ]; then
        echo "  (aucune version installee)"
        return
    fi

    for node_dir in "$top"/v*/; do
        [ -d "$node_dir" ] || continue
        local node_version
        node_version=$(basename "$node_dir")
        local priority
        priority=$(calc_priority "$node_version")
        printf "  %-16s %-10s %s\n" "$node_version" "$priority" "$top/$node_version"
    done

    echo
    echo "Alternative active:"
    local current
    current=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
    if [ -n "$current" ]; then
        local active_ver
        active_ver=$(echo "$current" | grep -oP 'v[\d.]+')
        local mode
        mode=$(update-alternatives --query node 2>/dev/null | grep '^Status:' | cut -d' ' -f2)
        printf "  %s  (mode: %s)\n" "$active_ver" "$mode"
    else
        echo "  (aucune alternative configuree)"
    fi
}

do_update()
{
    vecho "Suppression des anciennes alternatives..."
    for binary in "${!OLD_BIN[@]}"; do
        update-alternatives --remove-all "$binary" 2>/dev/null || true
    done
    update-alternatives --remove-all node 2>/dev/null || true

    vecho "Enregistrement de toutes les versions installees..."
    if [ ! -d "$top" ] || [ -z "$(ls -A "$top" 2>/dev/null)" ]; then
        echo >&2 "$prog: aucune version node dans $top"
        echo >&2 "  Installez avec: sudo $prog --install <version>"
        exit 1
    fi

    NEW_BIN=()
    NEW_BIN[node]=1
    declare -A PER_VER_BIN=()

    for node_dir in "$top"/v*/; do
        [ -d "$node_dir" ] || continue
        local node_version
        node_version=$(basename "$node_dir")
        local priority
        priority=$(calc_priority "$node_version")
        local NODEBIN_DIR="$top/${node_version}/bin"

        [ -x "$NODEBIN_DIR/node" ] || continue

        vecho "  -> $node_version (priorite: $priority)"

        local cmd=(update-alternatives "${uaopts[@]}" --install
            "$ALTBIN_DIR/node" node "$NODEBIN_DIR/node" "$priority")

        local slave_bins=() slave_bin
        while IFS= read -r slave_bin; do
            [ -n "$slave_bin" ] || continue
            cmd+=(--slave "$ALTBIN_DIR/$slave_bin" "$slave_bin" "$NODEBIN_DIR/$slave_bin")
            NEW_BIN[$slave_bin]=1
            slave_bins+=("$slave_bin")
        done < <(scan_slaves "$NODEBIN_DIR")

        PER_VER_BIN[$node_version]="${slave_bins[*]}"
        vecho "     slaves: ${slave_bins[*]:-<none>}"

        "${cmd[@]}"
    done

    # node_binaries.info: union sur la premiere ligne (compat 0.2/0.3),
    # puis une ligne Binaries.<version>=... par version pour permettre
    # des diagnostics fins (et un futur cleanup chirurgical par version).
    local sorted_union
    sorted_union=$(printf '%s\n' "${!NEW_BIN[@]}" | sort | tr '\n' ' ')
    sorted_union=${sorted_union% }
    {
        echo "Binaries=$sorted_union"
        local v
        for v in $(printf '%s\n' "${!PER_VER_BIN[@]}" | sort); do
            echo "Binaries.${v}=${PER_VER_BIN[$v]}"
        done
    } > "$node_info"
    vecho "Binaries=$sorted_union"

    echo "Alternatives mises a jour. Versions enregistrees:"
    update-alternatives --list node 2>/dev/null | while read -r path; do
        local v
        v=$(echo "$path" | grep -oP 'v[\d.]+')
        echo "  $v -> $path"
    done
}

do_set()
{
    [ -n "$nodename" ] || { echo >&2 "$prog: nodename requis"; usage 1; }

    # S'assurer que les alternatives sont a jour
    do_update

    local version
    version=$(resolve_local "$nodename")

    local NODEBIN_DIR="$top/${version}/bin"
    if [ ! -x "$NODEBIN_DIR/node" ]; then
        echo >&2 "$prog: version $version introuvable dans $top"
        echo >&2 "  Versions disponibles:"
        list_installed_versions | sed 's/^/    /' >&2
        exit 1
    fi

    # Detecter la version precedente pour migration des paquets globaux
    local old_node_bin
    old_node_bin=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
    local old_version=""
    if [ -n "$old_node_bin" ] && [ -x "$old_node_bin" ]; then
        old_version=$(echo "$old_node_bin" | grep -oP 'v[\d.]+')
    fi

    vecho "Basculement vers $version..."
    update-alternatives "${uaopts[@]}" --set node "$NODEBIN_DIR/node"

    echo "Node.js system-wide defini sur $version (mode manuel)"
    echo "  node: $("$ALTBIN_DIR/node" --version 2>/dev/null)"
    echo "  npm:  $("$ALTBIN_DIR/npm" --version 2>/dev/null)"

    # Proposer la migration des paquets globaux si changement de version
    if [ -n "$old_version" ] && [ "$old_version" != "$version" ]; then
        migrate_global_packages "$old_version" "$version"
    fi
}

do_auto()
{
    do_update

    update-alternatives "${uaopts[@]}" --auto node
    echo "Node.js alternatives en mode automatique (plus haute priorite active)"

    local current
    current=$(update-alternatives --query node 2>/dev/null | grep '^Value:' | cut -d' ' -f2)
    if [ -n "$current" ]; then
        local v
        v=$(echo "$current" | grep -oP 'v[\d.]+')
        echo "  -> version active: $v"
    fi
}

# ---------------------------------------------------------------------------
# Migration des paquets globaux (interface debconf/whiptail)
# ---------------------------------------------------------------------------

migrate_global_packages()
{
    local from_version="$1"
    local to_version="$2"
    local to_bin="$top/$to_version/bin"

    collect_global_packages "$from_version"

    if [ ${#pkg_names[@]} -eq 0 ]; then
        vecho "Aucun paquet global a migrer depuis $from_version"
        return
    fi

    # Construire les arguments pour le checklist
    # Format: tag description on/off
    local checklist_args=()
    local i
    for i in "${!pkg_names[@]}"; do
        local tag="${pkg_names[$i]}"
        local desc="${pkg_names[$i]}@${pkg_versions[$i]}"
        if [ -n "${pkg_descriptions[$i]}" ]; then
            desc="$desc - ${pkg_descriptions[$i]}"
        fi
        checklist_args+=("$tag" "$desc" "ON")
    done

    echo
    local selected
    if selected=$(dialog_checklist \
        "Migration des paquets globaux" \
        "Selectionnez les paquets a migrer de $from_version vers $to_version:" \
        "${checklist_args[@]}"); then

        if [ -z "$selected" ]; then
            echo "  -> Migration ignoree (aucune selection)"
            return
        fi

        # Convertir la selection en tableau
        local to_install=()
        read -ra to_install <<< "$selected"

        if [ ${#to_install[@]} -eq 0 ]; then
            echo "  -> Migration ignoree"
            return
        fi

        echo ":: Installation de ${#to_install[@]} paquet(s) dans $to_version..."
        vecho "  Paquets: ${to_install[*]}"

        if "$to_bin/npm" install -g "${to_install[@]}"; then
            echo "  -> ${#to_install[@]} paquet(s) migre(s) avec succes"
        else
            echo >&2 "  -> ERREUR lors de l'installation de certains paquets"
            exit 1
        fi
    else
        echo "  -> Migration annulee"
    fi
}

# ---------------------------------------------------------------------------
# Promotion per-user -> system-wide / cleanup per-user (Phase 2 f)
# ---------------------------------------------------------------------------

do_promote_user_globals()
{
    if [ -z "${SUDO_USER:-}" ] || [ "$(id -u)" -ne 0 ]; then
        echo >&2 "$prog: --promote-user-globals doit etre lance via sudo"
        echo >&2 "  (besoin de \$SUDO_USER pour decouvrir les paquets per-user)"
        exit 1
    fi

    local user="$SUDO_USER"
    local user_prefix
    if ! user_prefix=$(get_user_npm_prefix "$user"); then
        echo >&2 "$prog: aucun prefix npm per-user trouve pour '$user'"
        echo >&2 "  cherche via 'sudo -u $user npm config get prefix' et ~/.npm-global"
        exit 1
    fi

    echo ":: Promotion: paquets npm globaux de '$user' vers la couche system-wide"
    echo "   prefix per-user : $user_prefix"

    collect_modules_dir "$user_prefix/lib/node_modules"
    local user_names=("${pkg_names[@]}")
    local user_vers=("${pkg_versions[@]}")
    local user_descs=("${pkg_descriptions[@]}")

    if [ ${#user_names[@]} -eq 0 ]; then
        echo "   aucun paquet npm -g per-user"
        return 0
    fi

    local sys_modules
    if ! sys_modules=$(active_node_modules_dir); then
        echo >&2 "$prog: aucune version Node.js system-wide active"
        echo >&2 "  Activez d'abord une version : sudo $prog --install <version>"
        exit 1
    fi

    declare -A sys_seen=()
    declare -A sys_ver=()
    collect_modules_dir "$sys_modules"
    local i
    for i in "${!pkg_names[@]}"; do
        sys_seen[${pkg_names[$i]}]=1
        sys_ver[${pkg_names[$i]}]="${pkg_versions[$i]}"
    done

    local candidates=() candidates_args=() name uv sv mark
    for i in "${!user_names[@]}"; do
        name="${user_names[$i]}"
        uv="${user_vers[$i]}"
        if [ -n "${sys_seen[$name]:-}" ]; then
            sv="${sys_ver[$name]}"
            if [ -n "$sv" ] && [ -n "$uv" ] && version_ge "$sv" "$uv"; then
                continue   # idempotence: deja >= version per-user
            fi
            mark="upgrade ${sv:-?} -> ${uv:-?}"
        else
            mark="absent system-wide"
        fi
        candidates+=("$name@$uv")
        local desc="$mark"
        [ -n "${user_descs[$i]}" ] && desc="$desc - ${user_descs[$i]}"
        candidates_args+=("$name@$uv" "$desc" "ON")
    done

    if [ ${#candidates[@]} -eq 0 ]; then
        echo "   tout est deja installe system-wide (>= version per-user)"
        return 0
    fi

    if [ "$frontend" = noninteractive ]; then
        echo "   ${#candidates[@]} paquet(s) candidat(s) a la promotion :"
        local c
        for c in "${candidates[@]}"; do
            echo "     $c"
        done
        echo "   (DEBIAN_FRONTEND=noninteractive : aucune action effectuee)"
        return 0
    fi

    local selected
    if ! selected=$(dialog_checklist \
        "Promotion per-user -> system-wide" \
        "Paquets npm -g de '$user' a installer system-wide :" \
        "${candidates_args[@]}"); then
        echo "   annule"
        return 0
    fi

    [ -n "$selected" ] || { echo "   aucune selection"; return 0; }

    local -a to_install
    read -ra to_install <<< "$selected"
    [ ${#to_install[@]} -gt 0 ] || { echo "   aucune selection"; return 0; }

    echo ":: Installation system-wide de ${#to_install[@]} paquet(s)..."
    # Garde-fou : NE PAS heriter du .npmrc utilisateur (registry, tokens
    # privees, etc.). HOME=/root force npm a utiliser /root/.npmrc et
    # /etc/npmrc, jamais $SUDO_USER/.npmrc.
    if ! HOME=/root npm install -g "${to_install[@]}"; then
        echo >&2 "  -> erreur lors de l'installation"
        exit 1
    fi

    echo ":: Mise a jour des alternatives (slaves dynamiques)..."
    do_update

    echo
    echo ":: Promotion terminee."

    if [ "$frontend" != noninteractive ] && \
       dialog_yesno "Cleanup per-user" \
         "Supprimer maintenant les copies per-user des paquets promus ?\n\nLa version system-wide les remplace via PATH (priorite definie par /etc/profile.d/update-node-alternatives.sh)."; then
        echo ":: Bascule vers --cleanup-user-globals (en tant que '$user')..."
        exec sudo -u "$user" -H -- "$0" --cleanup-user-globals
    fi
}

do_cleanup_user_globals()
{
    if [ "$(id -u)" -eq 0 ]; then
        echo >&2 "$prog: --cleanup-user-globals doit etre lance SANS sudo"
        echo >&2 "  (cette action ne touche que vos paquets per-user)"
        exit 1
    fi

    local self
    self=$(id -un)
    local user_prefix
    if ! user_prefix=$(get_user_npm_prefix "$self"); then
        echo >&2 "$prog: aucun prefix npm per-user trouve"
        exit 1
    fi

    echo ":: Cleanup: paquets per-user couvrables par la couche system-wide"
    echo "   prefix per-user : $user_prefix"

    collect_modules_dir "$user_prefix/lib/node_modules"
    local user_names=("${pkg_names[@]}")
    local user_vers=("${pkg_versions[@]}")
    local user_descs=("${pkg_descriptions[@]}")

    if [ ${#user_names[@]} -eq 0 ]; then
        echo "   aucun paquet npm -g per-user"
        return 0
    fi

    local sys_modules
    if ! sys_modules=$(active_node_modules_dir); then
        echo >&2 "$prog: aucune version Node.js system-wide active"
        exit 1
    fi

    declare -A sys_ver=()
    collect_modules_dir "$sys_modules"
    local i
    for i in "${!pkg_names[@]}"; do
        sys_ver[${pkg_names[$i]}]="${pkg_versions[$i]}"
    done

    local candidates=() candidates_args=() name uv sv
    for i in "${!user_names[@]}"; do
        name="${user_names[$i]}"
        uv="${user_vers[$i]}"
        sv="${sys_ver[$name]:-}"
        [ -n "$sv" ] || continue          # absent system-wide -> on garde
        [ -n "$uv" ] || continue          # version per-user inconnue -> garde
        if ! version_ge "$sv" "$uv"; then
            continue                       # system plus ancien -> garde
        fi
        local desc="system $sv >= user $uv"
        [ -n "${user_descs[$i]}" ] && desc="$desc - ${user_descs[$i]}"
        candidates+=("$name")
        candidates_args+=("$name" "$desc" "ON")
    done

    if [ ${#candidates[@]} -eq 0 ]; then
        echo "   rien a nettoyer (aucun paquet per-user couvert par system-wide)"
        return 0
    fi

    if [ "$frontend" = noninteractive ]; then
        echo "   ${#candidates[@]} paquet(s) couvrable(s) par la couche system-wide :"
        local c
        for c in "${candidates[@]}"; do
            echo "     $c"
        done
        echo "   (DEBIAN_FRONTEND=noninteractive : aucune action effectuee)"
        return 0
    fi

    local selected
    if ! selected=$(dialog_checklist \
        "Cleanup paquets per-user" \
        "Paquets npm -g per-user a desinstaller (deja couverts system-wide) :" \
        "${candidates_args[@]}"); then
        echo "   annule"
        return 0
    fi

    [ -n "$selected" ] || { echo "   aucune selection"; return 0; }

    local -a to_remove
    read -ra to_remove <<< "$selected"
    [ ${#to_remove[@]} -gt 0 ] || { echo "   aucune selection"; return 0; }

    echo ":: Desinstallation per-user de ${#to_remove[@]} paquet(s)..."
    if ! npm uninstall -g "${to_remove[@]}"; then
        echo >&2 "  -> erreur lors de la desinstallation"
        exit 1
    fi

    echo ":: Cleanup termine."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

# Actions ne necessitant pas root
readonly NO_ROOT_ACTIONS="list list_remote list_packages cleanup_user_globals"

if ! echo "$NO_ROOT_ACTIONS" | grep -qw "$action"; then
    if [ "$(id -u)" -ne 0 ]; then
        echo >&2 "$prog: droits root requis (utilisez sudo)"
        exit 1
    fi
fi

# Charger les binaires precedemment enregistres
if [ -f "$node_info" ]; then
    while IFS='=' read -r key value; do
        [ "$key" = "Binaries" ] || continue
        for binary in $value; do
            OLD_BIN[$binary]=1
        done
    done < "$node_info"
fi

[ -z "$verbose" ] || do_show_setting
do_$action

exit 0
