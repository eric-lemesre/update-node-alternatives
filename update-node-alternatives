#!/bin/bash
#
# update-node-alternatives - Gestion system-wide de Node.js via NVM + update-alternatives
#
# Utilise l'infrastructure NVM (versions installees dans /usr/local/share/nvm/versions/node/)
# et le systeme update-alternatives de Debian pour le basculement.
# Interface interactive via whiptail (frontend debconf standard).
#
